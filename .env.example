# Explicitly opt in to the fake seeded preview for local or private review.
# Leave unset or false in the production App Service.
PHASE_ONE_PREVIEW=true

# Optional only for a controlled end-to-end Phase 1 token test.
PHASE_ONE_PROFILE_EMAIL=person@example.com

# Standard base64 that decodes to 32 bytes. In Azure, use a Key Vault-backed
# App Service setting shared with Broker Day. Never commit a real value.
QR_TOKEN_KEY=
