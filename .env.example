# Explicitly opt in to the fake seeded preview for local or private review.
# Leave unset or false in the production App Service.
PHASE_ONE_PREVIEW=true

# Optional only for a controlled local Phase 1 token test. This applies only
# when BROKER_DAY_PROFILE_API_URL is unset, so a real identity is never attached
# to the demonstration genotypes.
PHASE_ONE_TOKEN_TEST=false
PHASE_ONE_PROFILE_EMAIL=person@example.com

# Production gene result source. Azure uses the App Service managed identity;
# no SQL password or connection string is required.
GENE_RESULTS_SOURCE=azure-sql
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=BrokerDay

# Optional only for a user-assigned managed identity. Leave unset for the
# App Service system-assigned identity.
AZURE_CLIENT_ID=

# Preferred production identity path. Use the existing Broker Day public
# profile endpoint, which decrypts the token and reads the shared Azure SQL
# database. The URL must be HTTPS and end in /api/person.
BROKER_DAY_PROFILE_API_URL=https://your-broker-day-site.example/api/person

# Shared-token fallback for direct SAM recipients that have no qualifying
# Broker Day /api/person record. Store it as an App Service Key Vault reference,
# not in source control. Standard base64 that decodes to 32 bytes.
QR_TOKEN_KEY=
